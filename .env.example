# Model backend: local (default, LM Studio) or api (OpenAI-compatible service).
NOVEL_LLM_PROVIDER=local

# Optional runtime data directory. Source checkouts default to this repository;
# installed packages default to the operating system's user data directory.
# NOVEL_WORKSPACE_HOME=/path/to/novel-workspace-data

# API mode. The URL may be the service root or include /v1.
NOVEL_LLM_BASE_URL=http://127.0.0.1:1234/v1
NOVEL_LLM_API_KEY=
NOVEL_LLM_MODEL=ornith-1.0-35b-aeon-ultimate-uncensored-mtp-apex-i-compact
NOVEL_LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
NOVEL_LLM_TIMEOUT=600

# Optional Web protection for non-local deployments. Use 16+ random characters.
# NOVEL_WEB_ACCESS_TOKEN=

# Exact comma-separated frontend origins; wildcard origins are rejected.
# Leave empty for same-origin browser access only.
# NOVEL_WEB_CORS_ORIGINS=https://studio.example.com

# Docker Compose publishes to loopback by default. Override only when remote
# clients must reach the host, and configure NOVEL_WEB_ACCESS_TOKEN first.
# NOVEL_WEB_BIND_ADDRESS=127.0.0.1

# Optional local LM Studio / llama.cpp executable overrides (local mode only).
# NOVEL_LMS_PATH=
# NOVEL_LLAMA_SERVER_PATH=
