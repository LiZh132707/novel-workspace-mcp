# 模型后端：local（默认，LM Studio）或 api（OpenAI-compatible 服务）
NOVEL_LLM_PROVIDER=local

# API 模式配置。URL 可以填写服务根地址或带 /v1 的地址。
NOVEL_LLM_BASE_URL=http://127.0.0.1:1234/v1
NOVEL_LLM_API_KEY=
NOVEL_LLM_MODEL=ornith-1.0-35b-aeon-ultimate-uncensored-mtp-apex-i-compact
NOVEL_LLM_EMBED_MODEL=text-embedding-nomic-embed-text-v1.5
NOVEL_LLM_TIMEOUT=600

# 可选：覆盖本机 LM Studio / llama.cpp 可执行文件路径（仅 local 模式使用）
# NOVEL_LMS_PATH=
# NOVEL_LLAMA_SERVER_PATH=
